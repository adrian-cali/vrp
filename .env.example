# Database
POSTGRES_USER=vrp_user
POSTGRES_PASSWORD=vrp_password
POSTGRES_DB=vrp_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vrp_user:vrp_password@db:5432/vrp_db

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# VROOM
VROOM_URL=http://vroom:3000

# OSRM
OSRM_URL=http://osrm:5000

# Redis Cache TTL (seconds)
FM_LOCATION_TTL=600

# H3 Configuration
H3_ENABLED=false
H3_RESOLUTION=8

# API
API_HOST=0.0.0.0
API_PORT=8000
